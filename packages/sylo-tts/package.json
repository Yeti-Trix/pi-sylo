{
  "name": "sylo-tts",
  "version": "0.1.0",
  "description": "Local Kokoro / Orpheus text-to-speech for Sylo — voice catalog, agent tool, Speech sidebar route",
  "type": "module",
  "private": true,
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extensions",
    "scripts",
    "skills",
    "voices",
    "README.md"
  ],
  "scripts": {
    "build:ui": "vite build --config ui/vite.config.ts && node scripts/postbuild-ui.mjs",
    "test:voice-catalog": "esbuild extensions/voice-catalog.test.mjs --bundle --platform=node --format=esm --outfile=out/voice-catalog.test.mjs --packages=external && node --test out/voice-catalog.test.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills/tts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2"
  },
  "dependencies": {
    "typebox": "^1.1.24"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.3"
  }
}
