node_modules/
**/out/
dist/
# Generated build metadata (scripts/gen-build-info.mjs — regenerated on install/build)
apps/host/src/generated/
tracker-dashboard.html
.DS_Store
*.log
.env
.env.local
Thumbs.db

# Tool ephemeral image caches beside source files (legacy)
**/.schematic-reader/
**/.sylo-pdf-reader/
**/docx-extract/

# Studio 5000 work/lock files created alongside .acd when Logix Designer edits a project
# (logicforge run working copies). They block git push if present.
*.wrk
*.sem

# TypeScript incremental build cache (regenerated by tsc)
*.tsbuildinfo

# Python bytecode cache (regenerated on run)
__pycache__/
*.pyc

# Editor backup/swap files
*.bak
*.orig
*.rej
*.swp

# sylo-supervisor: last-known-good commit marker (local runtime artifact)
.sylo-last-good

# Skill-surface fixtures are runtime-mirrored from INSTALLED skills by
# scripts/sync-smoke-skills.mjs (prepare:dev / prestart). Only the skills that
# ship with sylo-dev packages are committed; skills from operator-installed
# packages (personal/controls/onenote bundles) stay local-only — committing
# them would leak operator data into the public repo (audit C1/C8/H1).
apps/host/test-fixtures/skill-surface/routes/*
!apps/host/test-fixtures/skill-surface/routes/tasks/
!apps/host/test-fixtures/skill-surface/routes/think-tank/
!apps/host/test-fixtures/skill-surface/routes/tts/
!apps/host/test-fixtures/skill-surface/routes/web-access/
!apps/host/test-fixtures/skill-surface/routes/sylo-workflows/
apps/host/test-fixtures/skill-surface/widgets/*

