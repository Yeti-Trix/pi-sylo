{
  "name": "@sylo/host",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build:broker": "esbuild src/broker/entry.ts --bundle --platform=node --format=esm --outfile=out/broker/broker.mjs --packages=external && esbuild src/broker/pi-windows-shell.ts --bundle --platform=node --format=esm --outfile=out/broker/pi-shell-lib.mjs --packages=external",
    "build:companion": "vite build --config vite.companion.config.ts",
    "postinstall": "npm run rebuild:native && node ../../scripts/gen-build-info.mjs",
    "gen:build-info": "node ../../scripts/gen-build-info.mjs",
    "rebuild:native": "node ../../scripts/rebuild-better-sqlite3.mjs",
    "prepare:dev": "npm run build:broker && npm run build:companion && npm run build:ui -w sylo-tts && npm run build:ui -w sylo-think-tank && npm run build:ui -w sylo-workflows && npm run build:ui -w sylo-tasks && node ../../scripts/bootstrap-pi.mjs && node ../../scripts/sync-smoke-skills.mjs",
    "prestart": "npm run prepare:dev",
    "start": "electron-vite dev",
    "prebuild": "npm run build:broker && npm run build:companion && npm run build:ui -w sylo-tts && npm run build:ui -w sylo-think-tank && npm run build:ui -w sylo-workflows && npm run build:ui -w sylo-tasks && node ../../scripts/sync-smoke-skills.mjs",
    "build": "npm run build:broker && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:personal-plugin": "esbuild src/main/personal-plugin.test.mjs --bundle --platform=node --format=esm --outfile=out/test/personal-plugin.test.mjs --packages=external && node --test out/test/personal-plugin.test.mjs",
    "test:broker-shell": "npm run build:broker && node --test src/broker/pi-windows-shell.test.mjs",
    "test:bundled-skills": "esbuild src/broker/bundled-skill-discovery.test.mjs --bundle --platform=node --format=esm --outfile=out/test/bundled-skill-discovery.test.mjs --packages=external && node --test out/test/bundled-skill-discovery.test.mjs",
    "test:pi-builtin-tools": "esbuild src/broker/pi-builtin-tools.test.mjs --bundle --platform=node --format=esm --outfile=out/test/pi-builtin-tools.test.mjs --packages=external && node --test out/test/pi-builtin-tools.test.mjs",
    "test:sylo-sqlite-prefs": "esbuild src/shared/sylo-sqlite-prefs.test.mjs --bundle --platform=node --format=esm --outfile=out/test/sylo-sqlite-prefs.test.mjs --packages=external && node --test out/test/sylo-sqlite-prefs.test.mjs",
    "test:resolve-python": "esbuild src/shared/resolve-python.test.mjs --bundle --platform=node --format=esm --outfile=out/test/resolve-python.test.mjs --packages=external && node --test out/test/resolve-python.test.mjs",
    "test:capability-display-names": "esbuild src/broker/capability-display-names.test.mjs --bundle --platform=node --format=esm --outfile=out/test/capability-display-names.test.mjs --packages=external && node --test out/test/capability-display-names.test.mjs",
    "test:chat-scroll": "esbuild src/renderer/src/chat/chatScrollIntent.ts --bundle --platform=node --format=esm --outfile=out/test/chatScrollIntent.mjs --packages=external && node --test src/renderer/src/chat/chatScrollIntent.test.mjs",
    "test:sylo-surface-protocol": "esbuild src/shared/sylo-surface-protocol.ts --bundle --platform=node --format=esm --outfile=out/test/sylo-surface-protocol.mjs --packages=external && node --test src/shared/sylo-surface-protocol.test.mjs",
    "test:chat-title": "esbuild src/main/chat-title.test.mjs --bundle --platform=node --format=esm --outfile=out/test/chat-title.test.mjs --packages=external && node --test out/test/chat-title.test.mjs",
    "test:tool-telemetry": "esbuild src/main/tool-telemetry.ts --bundle --platform=node --format=esm --outfile=out/test/tool-telemetry.mjs --packages=external && node --test src/main/tool-telemetry.test.mjs",
    "test:ollama-context": "esbuild src/main/ollama-context.ts --bundle --platform=node --format=esm --outfile=out/test/ollama-context.mjs --packages=external && node --test src/main/ollama-context.test.mjs",
    "build:ollama-context-tools": "esbuild src/main/ollama-context.ts --bundle --platform=node --format=esm --outfile=out/test/ollama-context.mjs --packages=external && esbuild src/main/model-input.ts --bundle --platform=node --format=esm --outfile=out/test/model-input.mjs --packages=external",
    "sync:ollama-context": "npm run build:ollama-context-tools && node scripts/sync-ollama-context.mjs",
    "test:pinned-skills": "esbuild src/shared/sylo-capability-paths.ts --bundle --platform=node --format=esm --outfile=out/test/sylo-capability-paths.mjs --packages=external && node --test src/shared/sylo-pinned-skills.test.mjs",
    "test:skill-scope": "esbuild src/shared/sylo-skill-scope.test.mjs --bundle --platform=node --format=esm --outfile=out/test/sylo-skill-scope.test.mjs --packages=external && node --test out/test/sylo-skill-scope.test.mjs",
    "test:workflow-timing": "esbuild src/renderer/src/workflowTimeline.ts --bundle --platform=node --format=esm --outfile=out/test/workflowTimeline.mjs && node --test src/renderer/workflowTimeline.test.mjs",
    "test:compaction-notice": "esbuild src/shared/compaction-notice.ts --bundle --platform=node --format=esm --outfile=out/test/compaction-notice.mjs --packages=external && node --test src/shared/compaction-notice.test.mjs",
    "test:compaction-anchor": "esbuild src/broker/sylo-compaction-anchor.ts --bundle --platform=node --format=esm --outfile=out/test/compaction-anchor.mjs --packages=external && node --test src/broker/sylo-compaction-anchor.test.mjs",
    "test:schedule-recurrence": "esbuild src/shared/schedule-recurrence.ts --bundle --platform=node --format=esm --outfile=out/shared/schedule-recurrence.mjs --packages=external && node src/shared/schedule-recurrence.test.mjs",
    "diagnose:shell": "npm run build:broker && node scripts/diagnose-pi-shell.mjs",
    "test:subagent-tool-policy": "esbuild src/main/subagent-tool-policy.test.mjs --bundle --platform=node --format=esm --outfile=out/test/subagent-tool-policy.test.mjs --packages=external && node --test out/test/subagent-tool-policy.test.mjs",
    "test:subagent-agents": "esbuild src/main/subagent-agents.test.mjs --bundle --platform=node --format=esm --outfile=out/test/subagent-agents.test.mjs --packages=external && node --test out/test/subagent-agents.test.mjs",
    "test:global-agents": "esbuild src/main/global-agents.test.mjs --bundle --platform=node --format=esm --outfile=out/test/global-agents.test.mjs --packages=external && node --test out/test/global-agents.test.mjs",
    "test:chatgpt-codex": "esbuild src/shared/chatgpt-codex.ts --bundle --platform=node --format=esm --outfile=out/test/chatgpt-codex.mjs --packages=external && node --test src/shared/chatgpt-codex.test.mjs",
    "test:ask-question": "esbuild src/shared/ask-question.ts --bundle --platform=node --format=esm --outfile=out/test/ask-question.mjs --packages=external && node --test src/shared/ask-question.test.mjs",
    "test:subagent-mentions": "esbuild src/shared/subagent-mentions.ts --bundle --platform=node --format=esm --outfile=out/test/subagent-mentions.mjs --packages=external && node --test src/shared/subagent-mentions.test.mjs",
    "test:empty-reply": "esbuild src/broker/empty-reply.ts --bundle --platform=node --format=esm --outfile=out/test/empty-reply.mjs --packages=external && node --test src/broker/empty-reply.test.mjs",
    "test:orchestrator-resume": "esbuild src/shared/orchestrator-resume.ts --bundle --platform=node --format=esm --outfile=out/test/orchestrator-resume.mjs --packages=external && node --test src/shared/orchestrator-resume.test.mjs",
    "test:subagent-timeout": "esbuild ../../packages/sylo-subagents/extensions/subagent-timeout.test.mjs --bundle --platform=node --format=esm --outfile=out/test/subagent-timeout.test.mjs --packages=external && node --test out/test/subagent-timeout.test.mjs",
    "test:subagent-kill": "esbuild ../../packages/sylo-subagents/extensions/subagent-kill.test.mjs --bundle --platform=node --format=esm --outfile=out/test/subagent-kill.test.mjs --packages=external && node --test --test-force-exit out/test/subagent-kill.test.mjs",
    "test:subagent-plan-file": "esbuild ../../packages/sylo-subagents/extensions/plan-file.test.mjs --bundle --platform=node --format=esm --outfile=out/test/subagent-plan-file.test.mjs --packages=external && node --test out/test/subagent-plan-file.test.mjs",
    "test:subagent-plan-checklist": "esbuild ../../packages/sylo-subagents/extensions/plan-checklist.test.mjs --bundle --platform=node --format=esm --outfile=out/test/subagent-plan-checklist.test.mjs --packages=external && node --test out/test/subagent-plan-checklist.test.mjs",
    "test:model-max-tokens": "esbuild src/main/model-input.ts --bundle --platform=node --format=esm --outfile=out/test/model-input.mjs --packages=external && node --test src/main/model-max-tokens.test.mjs",
    "test:skill-nav-layout": "esbuild src/renderer/src/skill-nav-layout.ts --bundle --platform=node --format=esm --outfile=out/test/skill-nav-layout.mjs --packages=external && node --test src/renderer/src/skill-nav-layout.test.mjs",
    "test:subagent-batch-match": "esbuild src/renderer/src/components/subagent/matchSubagentBatches.ts --bundle --platform=node --format=esm --outfile=out/test/matchSubagentBatches.mjs --packages=external && node --test src/renderer/src/components/subagent/matchSubagentBatches.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "katex": "^0.17.0",
    "mermaid": "^11.16.1",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "selfsigned": "^5.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@earendil-works/pi-ai": "^0.84.2",
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.10.5",
    "electron-vite": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.3"
  }
}
